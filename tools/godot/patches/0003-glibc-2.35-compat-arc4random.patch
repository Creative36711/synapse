+++ b/platform/linuxbsd/glibc_compat.c
@@ -0,0 +1,30 @@
+/**************************************************************************/
+/*  glibc_compat.c                                                        */
+/**************************************************************************/
+/* The statically linked libstdc++ (std::random_device) references        */
+/* arc4random(), which only exists in glibc >= 2.36. Providing it here     */
+/* (on top of getrandom(), glibc >= 2.25) keeps the binary runnable on     */
+/* glibc 2.35 systems such as Ubuntu 22.04.                                */
+/**************************************************************************/
+
+#include <errno.h>
+#include <stdint.h>
+#include <sys/random.h>
+
+#if defined(__linux__) && defined(__GLIBC__)
+
+uint32_t arc4random(void) {
+	uint32_t value = 0;
+	for (;;) {
+		ssize_t r = getrandom(&value, sizeof(value), 0);
+		if (r == (ssize_t)sizeof(value)) {
+			return value;
+		}
+		if (r < 0 && errno != EINTR) {
+			// Should never happen on Linux >= 3.17; fail safe instead of returning weak randomness.
+			__builtin_trap();
+		}
+	}
+}
+
+#endif
