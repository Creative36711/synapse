{
  "name": "synapse-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Проверяемые контракты ядра Synapse: GameSpec, манифест модуля, реестр кодов ошибок",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check:contracts": "node tests/contracts/check-contracts.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:validation": "node --test tests/validation/*.test.mjs",
    "test:modules": "node --test tests/modules/*.test.mjs",
    "i18n-check": "node tools/i18n/check.mjs",
    "i18n-no-literals": "node tools/i18n/no-literals.mjs",
    "test:i18n": "node --test tests/i18n/*.test.mjs",
    "test:deps": "python3 -B tests/deps/test_vendor.py"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
